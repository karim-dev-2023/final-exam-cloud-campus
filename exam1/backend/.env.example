# Configuration locale uniquement : ne jamais publier les vraies valeurs.
MONGO_URI=mongodb://localhost:27017/exam1Db
PORT=5000
JWT_SECRET=<generer-un-secret-aleatoire-distinct>
NOTIFICATION_SERVICE_TOKEN=<generer-un-jeton-base64url-de-43-a-128-caracteres>
NOTIFICATION_GATEWAY_URL=http://localhost:8000
# Destinataire des notifications de commande. Renseigner une adresse autorisee.
# Sans destinataire valide, la commande reste creee mais la notification echoue.
ORDER_NOTIFICATION_EMAIL=
